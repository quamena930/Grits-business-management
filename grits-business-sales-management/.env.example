# Copy this file to .env and fill in real values for production.
# config.py reads these with safe development defaults, so the app runs
# fine without a .env file locally - this is only needed for deployment.

SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///instance/sales.db
BUSINESS_NAME=Grits Business
BUSINESS_ADDRESS=12 Ring Road, Accra
BUSINESS_PHONE=+233 20 000 0000
BUSINESS_EMAIL=hello@gritsbusiness.example
CURRENCY_SYMBOL=GH₵
DEFAULT_TAX_RATE=0
